+    // Generic local-API action ("api" without a record-hd payload). Handled in
+    // Rust for the same reason as record-hd above: the JS listener lives in
+    // the overlay webview, which is usually not mounted when a native
+    // notification is clicked, so the click silently did nothing on macOS.
+    // Same target rule as `isLocalApiUrl` (lib/api.ts): only a relative path
+    // or an http URL on localhost/127.0.0.1 at the local API port, because the
+    // request carries the user's bearer key. Actions that also open a
+    // deeplink keep going through the JS handler.
+    if action_type == Some("api") {
+        if let Some(action) = parsed.as_ref() {
+            let has_deeplink = action
+                .get("deeplinkUrl")
+                .or_else(|| action.get("deeplink_url"))
+                .is_some();
+            if let (Some(url), false) = (action.get("url").and_then(|v| v.as_str()), has_deeplink) {
+                let api = crate::recording::local_api_context_from_app(app);
+                let Some(target) = local_api_action_target(url, api.port) else {
+                    warn!("refused api action to non-local url: {}", url);
+                    return;
+                };
+                let method = action
+                    .get("method")
+                    .and_then(|v| v.as_str())
+                    .unwrap_or("POST")
+                    .to_uppercase();
+                let body = action.get("body").cloned();
+                std::thread::spawn(move || {
+                    let client = reqwest::blocking::Client::new();
+                    let method = reqwest::Method::from_bytes(method.as_bytes())
+                        .unwrap_or(reqwest::Method::POST);
+                    let mut req = api.apply_auth_blocking(client.request(method, &target));
+                    if let Some(body) = body {
+                        req = req
+                            .header("Content-Type", "application/json")
+                            .body(body.to_string());
+                    }
+                    match req.send() {
+                        Ok(res) if res.status().is_success() => {}
+                        Ok(res) => error!("api action {} failed: HTTP {}", target, res.status()),
+                        Err(e) => error!("api action {} failed: {}", target, e),
+                    }
+                });
+                return;
+            }
+        }
+    }
