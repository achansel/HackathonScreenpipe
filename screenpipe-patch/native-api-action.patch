+#[cfg(test)]
+mod local_api_action_target_tests {
+    use super::local_api_action_target;
+
+    #[test]
+    fn accepts_relative_paths_and_local_api_urls() {
+        assert_eq!(
+            local_api_action_target("/connections/n8n/proxy", 3030).as_deref(),
+            Some("http://localhost:3030/connections/n8n/proxy")
+        );
+        assert_eq!(
+            local_api_action_target("http://127.0.0.1:3030/feedback", 3030).as_deref(),
+            Some("http://127.0.0.1:3030/feedback")
+        );
+    }
+
+    #[test]
+    fn refuses_other_hosts_ports_and_schemes() {
+        for url in [
+            "http://127.0.0.1:8787/hook",
+            "http://localhost:11435/notify",
+            "https://localhost:3030/feedback",
+            "http://evil.example:3030/feedback",
+            "//evil.example/feedback",
+            "file:///etc/passwd",
+        ] {
+            assert_eq!(local_api_action_target(url, 3030), None, "{url}");
+        }
+    }
+}
