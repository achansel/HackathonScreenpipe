+/// Resolve an `api` notification action URL to a local-API target, or `None`
+/// when it points anywhere else. Mirrors `isLocalApiUrl` in lib/api.ts.
+fn local_api_action_target(url: &str, api_port: u16) -> Option<String> {
+    if url.starts_with('/') && !url.starts_with("//") {
+        return Some(format!("http://localhost:{}{}", api_port, url));
+    }
+    let parsed = url::Url::parse(url).ok()?;
+    let host_ok = matches!(parsed.host_str(), Some("localhost") | Some("127.0.0.1"));
+    if parsed.scheme() == "http" && host_ok && parsed.port() == Some(api_port) {
+        Some(parsed.to_string())
+    } else {
+        None
+    }
+}
